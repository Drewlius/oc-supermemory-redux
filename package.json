{
  "name": "superMemory-Redux_OpenCode",
  "version": "0.2.2",
  "description": "Clean supermemory plugin for OpenCode — follows the docs, nothing more",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "bun build ./src/index.ts --outdir ./dist --target node && tsc --emitDeclarationOnly",
    "typecheck": "tsc --noEmit"
  },
  "keywords": ["opencode", "supermemory", "plugin", "memory"],
  "license": "MIT",
  "dependencies": {
    "@opencode/plugin": "latest",
    "supermemory": "^4.0.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "latest"
  },
  "opencode": {
    "type": "plugin",
    "hooks": ["chat.message"]
  }
}
